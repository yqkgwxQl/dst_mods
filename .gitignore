# ---- 游戏源码与参考资料 ----
# 约 270 MB，来自 data/databundles/scripts.zip 解压，且属于 Klei 的内容。
# 换机器用 tools/prepare_refs.ps1 重建。
refs/

# ---- 第三方工具与编译好的二进制 ----
# 约 160 MB。工具本身按 docs/ 里的说明自行下载，不随本仓库分发。
tools/app/
tools/cli/
tools/gui/

# ---- 临时目录与中间产物 ----
_trash/
_scratch/
_probe_backup/
*.tool_export
*.new
*.bak
*.tmp

# ---- 本机环境相关 ----
# 绝对路径、玩家 ID、本地集群名这类只对一台机器有意义的内容。
*.local.md

# ---- 系统与编辑器 ----
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
