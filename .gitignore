# ============================================================
#  饥荒联机版 MOD 开发仓库 —— 忽略规则
#
#  原则：只有「自己写的、体积小的」进版本库。
#        第三方二进制、游戏源码副本、临时产物一律排除。
# ============================================================

# ---- 游戏源码与参考资料 ----
# 约 270 MB，来自 data/databundles/scripts.zip 解压，且属于 Klei 的内容。
# 换机器用 tools/prepare_refs.ps1 重建。
refs/

# ---- 第三方工具与编译好的二进制 ----
# 约 160 MB。工具本身按 docs/ 里的说明自行下载，不随本仓库分发。
tools/app/
tools/cli/
tools/gui/

# ---- 临时目录与中间产物 ----
_trash/
_scratch/
_probe_backup/
_testcluster*/
*.tool_export
*.new
*.bak
*.tmp

# ---- 素材替换前的本地备份 ----
# 例如 mods/blade_of_the_ruined_king/_backup_anim_2026-11-12/
mods/**/_backup_anim_*/

# ---- 本机环境相关 ----
# 绝对路径、玩家 ID、本地集群名这类只对一台机器有意义的内容。
*.local.md

# ---- 大型二进制素材 ----
# 例如 setting/asset/viego_base.glb（9.6 MB），只在本地当参考，不进版本库。
*.glb

# ---- 临时测试脚本 ----
# 按《MOD测试手册》14.6：测试通过后直接删除，不入库。
mods/**/scripts/autotest.lua

# ---- 系统与编辑器 ----
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
